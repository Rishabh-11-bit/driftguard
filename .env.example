# ============================================================
# DriftGuard — Environment Configuration
# Copy to .env and fill in your values.
# ============================================================

# ----- LLM Provider -----
# Options: "openai" | "ollama"
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# ----- Memory Backend -----
# Options: "faiss" | "chroma"
MEMORY_BACKEND=faiss

# Chroma (used when MEMORY_BACKEND=chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# FAISS index persistence path
FAISS_INDEX_PATH=./data/faiss_index

# ----- Embedding Model -----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Enforcement Policy -----
# Quarantine queue backend: "memory" | "jsonl" | "redis"
QUARANTINE_BACKEND=jsonl
QUARANTINE_PATH=./data/quarantine_queue.jsonl

# Redis (used when QUARANTINE_BACKEND=redis)
REDIS_URL=redis://localhost:6379

# ----- Detector -----
DETECTOR_MODEL_PATH=./models/classifier.pkl

# ----- Benchmark -----
BENCHMARK_PATH=./data/benchmark.jsonl
BENCHMARK_N_MALICIOUS=200
BENCHMARK_N_DRIFT=200
BENCHMARK_N_ORDINARY=200

# ----- Logging -----
LOG_LEVEL=INFO
